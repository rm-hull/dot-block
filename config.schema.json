        "ttl_floor": {
          "description": "Minimum TTL for cached entries.",
          "format": "duration",
          "pattern": "^([0-9]+(?:\\.[0-9]+)?(?:ns|us|µs|ms|s|m|h))+$",
          "type": "string"
        }
      },
      "type": "object"
    },
