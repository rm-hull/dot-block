FROM gcr.io/distroless/static:nonroot

ARG TARGETPLATFORM

ENV GIN_MODE=release
ENV TZ=UTC

WORKDIR /app

# GoReleaser provides the pre-built binary under $TARGETPLATFORM/ in the build context
COPY $TARGETPLATFORM/dot-block .

USER nonroot:nonroot

EXPOSE 80/tcp
EXPOSE 853/tcp

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["./dot-block", "healthcheck"]

ENTRYPOINT ["./dot-block"]