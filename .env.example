# dot-block configuration
# These env vars can also be set in config.yaml under their respective sections.
# See config.proposed.yaml for the full configuration file format.
# Environment variables override config.yaml values.

# --- Server ---
DEV_MODE="<Optional true/false>"

# --- Let's Encrypt / ACME (server.lets_encrypt in config.yaml) ---
ACME_EMAIL="<ACME email for certificate management>"
CLOUDFLARE_API_TOKEN="<Cloudflare API token>"

# --- Geoblock (geoblock.ipinfo in config.yaml) ---
IPINFO_TOKEN="<IPInfo.io API token>"

# --- Telemetry (telemetry in config.yaml) ---
SENTRY_DSN="<Optional Sentry DSN>"
OTEL_EXPORTER_OTLP_ENDPOINT="<Optional OTLP gRPC endpoint, e.g. localhost:4317>"
OTEL_SAMPLING_RATIO="<Optional sampling ratio 0.0-1.0>"

# --- Metrics auth (telemetry.metrics_auth in config.yaml) ---
METRICS_AUTH="<Optional basic auth credentials for /metrics (user:pass)>"